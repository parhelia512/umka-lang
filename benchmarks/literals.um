import "std.um"

type T = struct {
    id: int
    data: [100]int 
}

fn test*() {
    for i := 0; i < 10_000_000; i++ {
        a := [3][3]T{
            {{id: 1}, {id: 2}, {id: 3}},
            {{id: 4}, {id: 5}, {id: 6}},
            {{id: 7}, {id: 8}, {id: 9}}
        }
        std::assert(a[2][2].id == 9)
    }
    printf("OK\n")
}

fn main() {
    test()
}